# Copy to .env.local for local development. Never put secrets in web/: FastAPI's legacy mount
# can serve this folder at /static when RELAY_SERVE_WEB=true.

# Server-only. Origin of a real FastAPI backend, read at request time by the /api, /auth and
# /health route handlers. Leave unset to run the synthetic demo only ("Backend not connected").
# Local example: http://127.0.0.1:8000   Funnel example: https://<laptop>.<tailnet>.ts.net
RELAY_API_BASE_URL=

# Public (shipped to browsers). A real Discord bot invite link; the "Add RELAY to Discord" button
# appears only when this is set. An invite link is not a secret.
NEXT_PUBLIC_DISCORD_INVITE_URL=
