# Template only. Never commit a populated .env.
# local | production. production refuses synthetic identities, needs a strong key, HTTPS auth
# settings and an explicitly migrated database (python -m relay.migrate).
RELAY_ENV=local
# SQLite path (one API instance, persistent volume) or postgresql://... DATABASE_URL also accepted.
RELAY_DB=relay.sqlite3
# Generate a random value of at least 32 characters; keep server-side (API, bot, n8n only).
RELAY_SERVICE_KEY=
# Where the bot reaches the API.
RELAY_BASE_URL=http://127.0.0.1:8000
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Browser login (Discord OAuth, scope identify). Leave blank to keep browser login unavailable.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Exact URL registered in the Discord portal; on the FRONTEND domain (Next.js proxies /auth).
RELAY_OAUTH_REDIRECT_URI=http://localhost:3000/auth/discord/callback
RELAY_FRONTEND_URL=http://localhost:3000
# Exact origins allowed to send cookie-authenticated mutations (comma-separated, no wildcards).
RELAY_ALLOWED_ORIGINS=http://localhost:3000
RELAY_WEB_SESSION_HOURS=12
# Secure cookies are forced in production; set true locally only when serving over HTTPS.
RELAY_COOKIE_SECURE=false

# Curated hints work without any model account.
RELAY_MODEL_PROVIDER=none
GEMINI_API_KEY=
# Set an actual model ID verified in your own provider account before enabling inference.
RELAY_MODEL=
RELAY_MODEL_TIMEOUT=15
RELAY_MODEL_MAX_OUTPUT_TOKENS=512
RELAY_MODEL_CONCURRENCY=2

# Keep delivery OFF until actual consent/cancellation/delivery tests pass.
RELAY_DELIVERY_ENABLED=false
# Days before sessions are purged by POST /internal/maintenance/purge.
RELAY_RETENTION_DAYS=30
# Legacy synthetic browser demo (identity switcher). Local only; production refuses it.
RELAY_PUBLIC_DEMO=true
# Serve the legacy static web/ UI from FastAPI if it exists. The API never requires it.
RELAY_SERVE_WEB=true
