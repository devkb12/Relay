# Template only. Never commit a populated .env.
RELAY_DB=relay.sqlite3
# Generate a random value of at least 32 characters; keep server-side.
RELAY_SERVICE_KEY=
RELAY_BASE_URL=http://127.0.0.1:8000
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Curated hints work without any model account.
RELAY_MODEL_PROVIDER=none
GEMINI_API_KEY=
# Set an actual model ID verified in your own provider account before enabling inference.
RELAY_MODEL=
# Keep delivery OFF until actual consent/cancellation/delivery tests pass.
RELAY_DELIVERY_ENABLED=false
# Local synthetic browser demo only. Set false before any public deployment.
RELAY_PUBLIC_DEMO=true
