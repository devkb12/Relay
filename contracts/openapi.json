  "components": {
    "schemas": {
      "Advance": {
        "properties": {
          "expected_stage": {
            "type": "string",
            "enum": [
              "lobby",
              "diagnostic",
              "discussion",
              "transfer",
              "debrief"
            ],
            "title": "Expected Stage"
          },
          "nonresponders": {
            "type": "string",
            "enum": [
              "wait",
              "mark_missing"
            ],
            "title": "Nonresponders",
            "default": "wait"
          }
        },
        "type": "object",
        "required": [
          "expected_stage"
        ],
        "title": "Advance"
      },
      "Answer": {
        "properties": {
          "question_id": {
            "type": "string",
            "maxLength": 80,
            "title": "Question Id"
          },
          "choice": {
            "type": "string",
            "maxLength": 8,
            "title": "Choice"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "unsure",
              "somewhat",
              "confident"
            ],
            "title": "Confidence",
            "default": "unsure"
          },
          "rationale": {
            "type": "string",
            "maxLength": 600,
            "title": "Rationale",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "question_id",
          "choice"
        ],
        "title": "Answer"
      },
      "Approval": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "accept_shorter": {
            "type": "boolean",
            "title": "Accept Shorter",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "Approval"
      },
      "BotRequest": {
        "properties": {
          "channel": {
            "type": "string",
            "maxLength": 100,
            "title": "Channel"
          },
          "user_id": {
            "type": "string",
            "pattern": "^\\d{1,25}$",
            "title": "User Id"
          },
          "name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Name"
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "join",
              "view",
              "advance",
              "answer",
              "explain",
              "availability",
              "propose",
              "approve",
              "consent",
              "facilitate",
              "challenge",
              "resolve",
              "review",
              "cancel_plan",
              "leave",
              "delete"
            ],
            "title": "Action"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "channel",
          "user_id",
          "name",
          "action"
        ],
        "title": "BotRequest"
      },
      "Challenge": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "Challenge"
      },
      "Consent": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "Consent"
      },
      "Create": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Name"
          },
          "concept_id": {
            "type": "string",
            "maxLength": 60,
            "title": "Concept Id",
            "default": "compound-change"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Create"
      },
      "Durations": {
        "properties": {
          "durations": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Durations",
            "default": [
              60,
              45,
              30
            ]
          }
        },
        "type": "object",
        "title": "Durations"
      },
      "ErrorReport": {
        "properties": {
          "workflow": {
            "type": "string",
            "maxLength": 100,
            "title": "Workflow",
            "default": "unknown"
          },
          "execution": {
            "type": "string",
            "maxLength": 100,
            "title": "Execution",
            "default": "unknown"
          }
        },
        "type": "object",
        "title": "ErrorReport"
      },
      "Explain": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1200,
            "title": "Text",
            "default": ""
          },
          "source_fallback": {
            "type": "boolean",
            "title": "Source Fallback",
            "default": false
          }
        },
        "type": "object",
        "title": "Explain"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Join": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Join"
      },
      "Reconcile": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "sent",
              "failed",
              "cancelled"
            ],
            "title": "Outcome"
          },
          "note": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "outcome",
          "note"
        ],
        "title": "Reconcile"
      },
      "Resolve": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "resume",
              "discard"
            ],
            "title": "Decision"
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "minLength": 10,
            "title": "Note"
          },
          "challenge_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Challenge Id"
          }
        },
        "type": "object",
        "required": [
          "decision",
          "note"
        ],
        "title": "Resolve"
      },
      "TickRequest": {
        "properties": {
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "reminder",
                  "retention"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Kind"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "default": true
          }
        },
        "type": "object",
        "title": "TickRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Window": {
        "properties": {
          "start": {
            "type": "string",
            "maxLength": 40,
            "title": "Start"
          },
          "end": {
            "type": "string",
            "maxLength": 40,
            "title": "End"
          }
        },
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "Window"
      },
      "Windows": {
        "properties": {
          "windows": {
            "items": {
              "$ref": "#/components/schemas/Window"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 1,
            "title": "Windows"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Timezone"
          }
        },
        "type": "object",
        "required": [
          "windows"
        ],
        "title": "Windows"
      }
    }
  }
