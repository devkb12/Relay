  "components": {
    "schemas": {
      "Advance": {
        "properties": {
          "expected_stage": {
            "type": "string",
            "title": "Expected Stage"
          }
        },
        "type": "object",
        "required": [
          "expected_stage"
        ],
        "title": "Advance"
      },
      "Answer": {
        "properties": {
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "choice": {
            "type": "string",
            "title": "Choice"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "unsure",
              "somewhat",
              "confident"
            ],
            "title": "Confidence",
            "default": "unsure"
          },
          "rationale": {
            "type": "string",
            "maxLength": 600,
            "title": "Rationale",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "question_id",
          "choice"
        ],
        "title": "Answer"
      },
      "Approval": {
        "properties": {
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "Approval"
      },
      "BotRequest": {
        "properties": {
          "channel": {
            "type": "string",
            "maxLength": 100,
            "title": "Channel"
          },
          "user_id": {
            "type": "string",
            "pattern": "^\\d+$",
            "title": "User Id"
          },
          "name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Name"
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "join",
              "view",
              "advance",
              "answer",
